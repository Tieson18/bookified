# Bookified environment template
# Copy this file to .env.local and replace every required placeholder.
# Never commit real secrets.

# Clerk browser configuration (public and bundled at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk server credential (secret)
CLERK_SECRET_KEY=sk_test_replace_me

# MongoDB Atlas connection string (secret)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/bookified?retryWrites=true&w=majority

# Optional: comma-separated DNS resolvers for mongodb+srv lookup problems
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Vercel Blob read-write token (secret)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# Vapi browser configuration (public values)
# Use a Vapi public web key, never a private server key.
NEXT_PUBLIC_ASSISTANT_ID=replace_with_vapi_assistant_id
NEXT_PUBLIC_VAPI_API_KEY=replace_with_vapi_public_web_key

# Vapi server webhook authentication (secret)
# Required in production when POST /api/vapi/search-book is configured.
VAPI_WEBHOOK_SECRET=

# Optional ElevenLabs server key (secret)
# Required only when POST /api/voice/synthesize is used.
# ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key
